# Ambiente de desenvolvimento LOCAL (docker-compose).
# Copie para .env.local e ajuste se necessário. NUNCA versione o .env.local.
# Este arquivo contém apenas placeholders/endpoints locais — sem chaves reais.

# Ordem de tentativa dos providers (separada por vírgula).
# No ambiente local usamos Ollama (custo zero, sem rede externa) com fallback opcional.
MODEL_PROVIDER_ORDER=ollama,openai

# Chaves de API dos providers (deixe vazio aqui; preencha no .env.local se for usar provider real)
OPENAI_API_KEY=
GROQ_API_KEY=

# Provider de LLM local (Ollama subido pelo docker-compose)
OLLAMA_HOST=http://localhost:11434

# Endpoint dos serviços AWS emulados pelo LocalStack
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Observabilidade (OpenTelemetry) — coletor OTLP local (SigNoz/Grafana/Langfuse)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Ambiente de execução; use "local" para ligar o debug_mode do Agno.
APP_ENV=local

# --- RAG / Knowledge (plugável por env) --------------------------------------
# Liga/desliga o RAG. Desligado (padrão), o agente roda sem base de conhecimento.
RAG_ENABLED=false
# Backend do vector DB: lancedb | pgvector | s3vectors
#   - lancedb   : local, sem servidor (default de estudo) -> usa RAG_LANCEDB_URI
#   - pgvector  : sobe com `docker compose --profile pgvector up` -> usa RAG_PG_DSN
#   - s3vectors : AWS-native/experimental (não emulado no LocalStack) -> só prod
RAG_VECTOR_DB=lancedb
# Tipo de busca: vector | keyword | hybrid
RAG_SEARCH_TYPE=hybrid
# Tabela/coleção de vetores e modelo de embeddings
RAG_TABLE_NAME=suporte
RAG_EMBEDDER_ID=text-embedding-3-small
# LanceDB: diretório local do índice (dentro da pasta do agente)
RAG_LANCEDB_URI=data/lancedb
# PgVector: DSN de conexão (perfil `pgvector` do compose expõe a porta 5433 no host).
# Deixe vazio se não usar pgvector. Contém credenciais — nunca versione com senha real.
RAG_PG_DSN=postgresql+psycopg://rag:rag@localhost:5433/rag
# Credenciais do container pgvector (usadas pelo docker-compose; casam com a DSN acima)
RAG_PG_USER=rag
RAG_PG_PASSWORD=rag
RAG_PG_DB=rag
# S3Vectors (só produção AWS): nome do bucket/índice de vetores. Vazio no local.
RAG_S3_VECTOR_BUCKET=

# --- Observabilidade de RAG (toggles por env; ver skill agno-observability) ---
RAG_TRACING_ENABLED=true
RAG_METRICS_ENABLED=true
# Inclui o texto dos chunks no span — SÓ em dev (pode conter PII). Nunca em prod.
RAG_TRACE_CONTENT=true
# Amostragem dos spans de retrieval (1.0 = tudo em dev)
RAG_SAMPLE_RATE=1.0

# --- Persistência: memory & sessions (DynamoDB por padrão) -------------------
# Backend do Db: dynamodb (padrão) | sqlite. No local, o DynamoDB é o do
# LocalStack (usa AWS_ENDPOINT_URL acima). O Agno cria as tabelas no 1º uso.
AGENT_DB_BACKEND=dynamodb
# Liga a memória de usuário (fatos duráveis por user_id). Sessions ficam sempre on.
AGENT_MEMORY_ENABLED=true
# Nomes das tabelas DynamoDB de sessions e memories (gerenciadas pelo Agno).
AGENT_DDB_SESSION_TABLE=suporte-sla-sessions
AGENT_DDB_MEMORY_TABLE=suporte-sla-memories
# Fallback local sem AWS (só usado quando AGENT_DB_BACKEND=sqlite; requer sqlalchemy).
AGENT_SQLITE_FILE=data/agent.db

# Parâmetros de SLA / resiliência (padrões adequados ao ambiente local)
LLM_PER_ATTEMPT_TIMEOUT=10
LLM_TOTAL_TIMEOUT=25
LLM_MAX_ATTEMPTS=2
LLM_BACKOFF_BASE=0.5

# Auth Token da LocalStack (https://app.localstack.cloud → Workspace → Auth Token).
# Necessário para ativar recursos licenciados e ver o container no Web App.
# Preencha apenas no .env / .env.local (nunca neste arquivo de exemplo).
LOCALSTACK_AUTH_TOKEN=
LOCALSTACK_APP_INSPECTOR=1
