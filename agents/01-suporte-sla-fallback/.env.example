# Copie para .env e preencha com valores reais. NUNCA versione o .env.
# Este arquivo contém apenas placeholders/valores vazios — sem chaves reais.

# Chaves de API dos providers (deixe vazio aqui; preencha no .env)
OPENAI_API_KEY=
GROQ_API_KEY=

# Ordem de tentativa dos providers (separada por vírgula)
MODEL_PROVIDER_ORDER=openai,groq

# Parâmetros de SLA / resiliência
LLM_PER_ATTEMPT_TIMEOUT=10
LLM_TOTAL_TIMEOUT=25
LLM_MAX_ATTEMPTS=2
LLM_BACKOFF_BASE=0.5

# Observabilidade (OpenTelemetry)
# Endpoint OTLP do tracing; vazio/ausente desabilita a exportação (sem interromper).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Ambiente de execução; use "dev"/"development"/"local" para ligar o debug_mode do Agno.
APP_ENV=

# --- RAG / Knowledge (plugável por env) --------------------------------------
# Liga/desliga o RAG. Desligado (padrão), o agente roda sem base de conhecimento.
RAG_ENABLED=false
# Backend do vector DB: lancedb | pgvector | s3vectors (ver skill agno-knowledge-rag).
RAG_VECTOR_DB=lancedb
# Tipo de busca: vector | keyword | hybrid
RAG_SEARCH_TYPE=hybrid
RAG_TABLE_NAME=suporte
RAG_EMBEDDER_ID=text-embedding-3-small
# LanceDB: diretório do índice (em prod, disco/EFS montado).
RAG_LANCEDB_URI=data/lancedb
# PgVector: DSN completa (RDS/Aurora). Preencha no .env, nunca aqui. Contém segredo.
RAG_PG_DSN=
# S3Vectors (AWS-native): bucket/índice de vetores quando RAG_VECTOR_DB=s3vectors.
RAG_S3_VECTOR_BUCKET=

# --- Observabilidade de RAG (toggles por env; ver skill agno-observability) ---
RAG_TRACING_ENABLED=true
RAG_METRICS_ENABLED=true
# Conteúdo do chunk no span: mantenha FALSE em produção (pode conter PII).
RAG_TRACE_CONTENT=false
# Amostragem dos spans de retrieval em produção (ex.: 0.1 = 10%).
RAG_SAMPLE_RATE=0.1

# --- Persistência: memory & sessions (DynamoDB por padrão) -------------------
# Backend do Db: dynamodb (padrão) | sqlite. Em produção, DynamoDB na AWS real
# (deixe AWS_ENDPOINT_URL vazio). O Agno cria as tabelas/GSIs no primeiro uso; a
# função Lambda precisa de permissão DynamoDB (ver policy no template.yaml).
AGENT_DB_BACKEND=dynamodb
AGENT_MEMORY_ENABLED=true
AGENT_DDB_SESSION_TABLE=suporte-sla-sessions
AGENT_DDB_MEMORY_TABLE=suporte-sla-memories
# Fallback local (não usado em produção).
AGENT_SQLITE_FILE=data/agent.db
# Endpoint AWS: vazio = AWS real. Preencha só para apontar a um emulador local.
AWS_ENDPOINT_URL=
AWS_REGION=us-east-1

# Auth Token da LocalStack (https://app.localstack.cloud → Workspace → Auth Token).
# Usado pelo docker-compose para ativar o LocalStack. Preencha no .env, não aqui.
LOCALSTACK_AUTH_TOKEN=
