# Copie para .env e preencha com valores reais. NUNCA versione o .env.
# Este arquivo contém apenas placeholders/valores vazios — sem chaves reais.

# Chaves de API dos providers (deixe vazio aqui; preencha no .env)
OPENAI_API_KEY=
GROQ_API_KEY=

# Ordem de tentativa dos providers (separada por vírgula)
MODEL_PROVIDER_ORDER=openai,groq

# Parâmetros de SLA / resiliência
LLM_PER_ATTEMPT_TIMEOUT=10
LLM_TOTAL_TIMEOUT=25
LLM_MAX_ATTEMPTS=2
LLM_BACKOFF_BASE=0.5

# Observabilidade (OpenTelemetry)
# Endpoint OTLP do tracing; vazio/ausente desabilita a exportação (sem interromper).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Ambiente de execução; use "dev"/"development"/"local" para ligar o debug_mode do Agno.
APP_ENV=

# Auth Token da LocalStack (https://app.localstack.cloud → Workspace → Auth Token).
# Usado pelo docker-compose para ativar o LocalStack. Preencha no .env, não aqui.
LOCALSTACK_AUTH_TOKEN=
